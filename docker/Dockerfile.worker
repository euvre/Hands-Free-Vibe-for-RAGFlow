# hfv-worker — one issue task per container.
#
# Deliberately NOT included:
#   * dockerd / containerd — NO docker-in-docker. The container mounts
#     /var/run/docker.sock from the host and only ships the docker CLI +
#     compose plugin to manage SIBLING service containers (see docker/README).
#   * gh / Feishu credentials — delivery and messaging stay host-side.
#
# Toolchain pinned to match the host environment:
#   node 22 (cline 3.0.58 + chrome-devtools-mcp 1.8.0), python 3.13 via uv
#   (ragflow venv is uv-managed), go 1.26 (ragflow go.mod), google-chrome
#   stable for headless UI verification.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/inf \
    PATH=/usr/local/go/bin:/home/inf/.local/bin:/home/inf/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-20 main" \
      > /etc/apt/sources.list.d/llvm20.list \
    && curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
      | gpg --dearmor -o /usr/share/keyrings/kitware.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware.gpg] https://apt.kitware.com/ubuntu/ noble main" \
      > /etc/apt/sources.list.d/kitware.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ripgrep jq xz-utils \
      tini build-essential pkg-config \
      python3 socat iproute2 psmisc default-mysql-client \
      libnss3 libatk-bridge2.0-0 libgtk-3-0 libx11-xcb1 libasound2t64 \
      fonts-liberation fonts-noto-cjk \
      lld-20 clang-20 cmake libpcre2-dev libjemalloc-dev \
      libgl1 libglib2.0-0t64 \
    && ln -sf /usr/bin/ld.lld-20 /usr/bin/ld.lld \
    && ln -sf /usr/bin/clang-20 /usr/bin/clang \
    && ln -sf /usr/bin/clang++-20 /usr/bin/clang++ \
    && rm -rf /var/lib/apt/lists/* \
    && ld.lld --version && cmake --version | head -1

# google-chrome stable (headless via chrome-devtools-mcp --headless)
RUN curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
      > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/* \
    && google-chrome --version

# node 22 (matches the version the host wrappers pin for cline/MCP servers)
RUN curl -fsSL https://nodejs.org/dist/v22.23.1/node-v22.23.1-linux-x64.tar.xz \
      | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version

# go 1.26 (ragflow go.mod requires 1.26)
RUN curl -fsSL https://go.dev/dl/go1.26.4.linux-amd64.tar.gz \
      | tar -xz -C /usr/local \
    && go version

# docker CE CLI + compose plugin ONLY — never the daemon (no DinD).
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      | gpg --dearmor -o /usr/share/keyrings/docker.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
         docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/* \
    && docker --version && docker compose version

# uv (python 3.13 + ragflow venv, mirrors the host's uv-managed .venv)
RUN curl -LsSf https://astral.sh/uv/0.9.20/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version

# toolchain note: lld-20/clang-20/cmake/libpcre2/jemalloc/libGL live in the
# FIRST apt layer above so this file's slow layers below never invalidate
# when a system package is added again.

# cline CLI + chrome-devtools-mcp, globally under the worker user's prefix
# ubuntu:24.04 ships a default `ubuntu` user with UID 1000 — free that UID so
# the worker user matches the host `inf` (1000) and bind-mounted files keep
# their ownership readable/writable.
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -u 1000 -s /bin/bash inf \
    && mkdir -p /home/inf/.npm-global /workspace \
    && chown -R inf:inf /home/inf /workspace
USER inf
# npm's own cache rides a buildkit cache mount: re-running this layer (e.g.
# after a base-package change) reuses downloaded tarballs instead of
# re-fetching cline + chrome-devtools-mcp from the registry every time.
RUN --mount=type=cache,target=/home/inf/.npm,uid=1000,gid=1000 \
    npm config set prefix /home/inf/.npm-global \
    && npm install -g cline@3.0.58 chrome-devtools-mcp@1.8.0 \
    && cline --version

# cline MCP settings: only chrome-devtools, headless, per-slot profile dir —
# no DISPLAY/XAUTHORITY needed inside the container (host wrapper stays as-is
# for interactive/VS Code use; this copy is container-specific).
RUN mkdir -p /home/inf/.cline/data/settings
COPY --chown=inf:inf mcp-settings.worker.json /home/inf/.cline/data/settings/cline_mcp_settings.json

# entrypoint is ALSO baked in (the live copy rides the hfv repo mount at the
# same path and wins; this one keeps bare `docker run ... hfv-worker` usable
# for debugging without mounting the repo)
COPY --chown=inf:inf worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/worker-entrypoint.sh"]
